# Imagen fija de este paquete. Solo cámbiala para probar otra versión.
ACE_HLS_IMAGE=tscneo/ace-hls-viewer:2.6.0

# Dirección del Orchestrator ya instalado en la LAN/VPN.
ORCHESTRATOR_HOST=192.168.1.50
ORCHESTRATOR_PORT=8000

# Debe coincidir con API_KEY en el Orchestrator externo.
ORCHESTRATOR_API_TOKEN=cambia-este-token-compartido
ORCHESTRATOR_API_PREFIX=/api/v1
ORCHESTRATOR_URL=
ORCHESTRATOR_TIMEOUT=5

ACE_HLS_PORT=8088
STREAM_PUBLIC_ENDPOINT=

# Usa el mismo nombre que la variante local para conservar AceHLS.
ACE_HLS_DATA_VOLUME=ace_hls_data

CACHE_DURATION=300
PLAYLIST_REFRESH_INTERVAL=900
SOURCE_CONNECT_TIMEOUT=8
SOURCE_READ_TIMEOUT=30
SOURCE_MAX_BYTES=10485760
SOURCE_TLS_VERIFY=false
FFMPEG_RW_TIMEOUT=60
HLS_IDLE_TIMEOUT=120
URL_ORIGEN=

ENABLE_TRANSCODE=false
TRANSCODE_720P_BITRATE=2500k
TRANSCODE_480P_BITRATE=1000k
TRANSCODE_COMPAT_CRF=23

# Overrides avanzados. Déjalos comentados para usar el host remoto anterior.
# STREAM_PROXY_HOST=192.168.1.50
# STREAM_PROXY_PORT=8000
# STREAM_PUBLIC_PORT=8000
