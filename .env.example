# Configuración de AceHLS
# Puerto del host para la interfaz de visualización
ACE_HLS_PORT=8088
# Habilitar Transcoding
ENABLE_TRANSCODE=false
# IP del Servidor AceXY/AceStream
# Usa 'acexy' si se ejecuta en el mismo stack Docker, o la IP local si se ejecuta en otro lugar
ACEXY_IP=acexy

# Puerto de Enlace AceXY (Puerto unificado para Docker y acceso externo)
ACEXY_PORT=8080

# Token de Seguridad para el Orquestador (Opcional, si usas acestream-orchestrator)
ACEXY_API_TOKEN=defaultpassword

# Duración de la caché para la lista de canales en segundos
CACHE_DURATION=300

# URL de origen de la lista de reproducción M3U
URL_ORIGEN=https://example.com/lista_iptv.m3u

# Configuración de AceXY
ACEXY_SCHEME=http
ACEXY_HOST=acestream
# Puerto del Motor AceStream (Interno para AceXY)
ACESTREAM_PORT=6878
ACEXY_M3U8_STREAM_TIMEOUT=60s
ACEXY_M3U8=false
ACEXY_EMPTY_TIMEOUT=60s
ACEXY_BUFFER_SIZE=4MB
ACEXY_NO_RESPONSE_TIMEOUT=10s
