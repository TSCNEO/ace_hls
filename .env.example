# Configuración de AceHLS
# Puerto del host para la interfaz de visualización
ACE_HLS_PORT=8088
# Habilitar perfiles con recodificación
ENABLE_TRANSCODE=false
TRANSCODE_720P_BITRATE=2500k
TRANSCODE_480P_BITRATE=1000k
TRANSCODE_COMPAT_CRF=23
# Backend de streaming predeterminado
STREAM_BACKEND=orchestrator
ORCHESTRATOR_MODE=local
ORCHESTRATOR_HOST=orchestrator
ORCHESTRATOR_PORT=8000
# Overrides avanzados: en el despliegue habitual deben coincidir con el servicio local
STREAM_PROXY_HOST=orchestrator
STREAM_PROXY_PORT=8000
# Puerto visible desde los clientes IPTV y override opcional de URL
STREAM_PUBLIC_PORT=8000
STREAM_PUBLIC_ENDPOINT=

# Duración de la caché para la lista de canales en segundos
CACHE_DURATION=300

# Refresh autónomo de fuentes M3U (15 minutos)
PLAYLIST_REFRESH_INTERVAL=900

# Descarga/validación de fuentes (segundos y bytes)
SOURCE_CONNECT_TIMEOUT=8
SOURCE_READ_TIMEOUT=30
SOURCE_MAX_BYTES=10485760
# false conserva compatibilidad con fuentes internas/VPN con TLS propio
SOURCE_TLS_VERIFY=false

# Timeout de lectura FFmpeg contra el proxy upstream (segundos)
FFMPEG_RW_TIMEOUT=60

# Tiempo sin peticiones HLS antes de cerrar FFmpeg (segundos)
HLS_IDLE_TIMEOUT=120

# Contenedor y API de gestión del AceStream Orchestrator
ORCHESTRATOR_IMAGE=ghcr.io/krinkuto11/acestream-orchestrator:v2.1.0.3
ORCHESTRATOR_URL=
ORCHESTRATOR_API_PREFIX=/api/v1
ORCHESTRATOR_API_TOKEN=change-this-local-token
ORCHESTRATOR_TIMEOUT=5
ORCHESTRATOR_VPN_ENABLED=false

# Fuente inicial opcional; las demás se gestionan desde la WebUI
URL_ORIGEN=

# Compatibilidad del Compose legacy con AceXY
ACEXY_PORT=8080
ACEXY_PUBLIC_ENDPOINT=
ACEXY_PUBLIC_TOKEN=
ACEXY_SCHEME=http
ACEXY_HOST=acestream
# Puerto del Motor AceStream (Interno para AceXY)
ACESTREAM_PORT=6878
ACEXY_M3U8_STREAM_TIMEOUT=60s
ACEXY_M3U8=false
ACEXY_EMPTY_TIMEOUT=60s
ACEXY_BUFFER_SIZE=4MB
ACEXY_NO_RESPONSE_TIMEOUT=10s
