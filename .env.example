# Configuración de AceHLS
# Puerto del host para la interfaz de visualización
ACE_HLS_PORT=8088

# IP del Servidor AceXY/AceStream
# Usa 'acexy' si se ejecuta en el mismo stack Docker, o la IP local si se ejecuta en otro lugar
ACEXY_IP=acexy

# Puerto de Enlace AceXY (Puerto donde escucha AceXY, usado por AceHLS)
ACEXY_PORT=8080

# Duración de la caché para la lista de canales en segundos
CACHE_DURATION=300

# URL de origen de la lista de reproducción M3U
URL_ORIGEN=https://ipfs.io/ipns/k2k4r8oqlcjxsritt5mczkcn4mmvcmymbqw7113fz2flkrerfwfps004/data/listas/lista_iptv.m3u

# Configuración de AceXY
ACEXY_PORT_HOST=8090 # Puerto expuesto en el host, para visualizar el M3U 
ACEXY_LISTEN_ADDR=:8090 # Puerto interno para AceXY, debe coincidir con el puerto expuesto (para que funcione la interface Ace_HLS) 
ACEXY_SCHEME=http
ACEXY_HOST=acestream
# Puerto del Motor AceStream (Interno para AceXY)
ACESTREAM_PORT=6878
ACEXY_M3U8_STREAM_TIMEOUT=60s
ACEXY_M3U8=false
ACEXY_EMPTY_TIMEOUT=60s
ACEXY_BUFFER_SIZE=4MB
ACEXY_NO_RESPONSE_TIMEOUT=10s
